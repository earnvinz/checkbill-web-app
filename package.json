{
  "name": "checkbill-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "migration:create": "npx typeorm migration:create",
    "migration:generate": "npx typeorm-ts-node-commonjs migration:generate -d src/db/data-source.cli.ts",
