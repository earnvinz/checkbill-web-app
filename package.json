    "migration:revert": "npx typeorm-ts-node-commonjs migration:revert -d src/db/data-source.cli.ts"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.8",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.0",
    "@mui/material": "^6.4.0",
    "better-auth": "^1.5.4",
    "dotenv": "^17.3.1",
    "elysia": "^1.4.27",
    "env-var": "^7.5.0",
    "next": "14.2.23",
    "next-auth": "^4.24.13",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^18",
